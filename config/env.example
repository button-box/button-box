# Button Box configuration - installed as /etc/messagebox/env by setup.
# Contact identity and chat access are stored privately in contacts.json. Use
# messagebox-contact to add, remove, and enroll contacts and NFC cards.

# ALSA devices by card NAME (numbers shuffle between boots). Fresh setup
# replaces the microphone and speaker values with detected ALSA devices.
MSGBOX_MIC_DEV=plughw:CARD=mic,DEV=0
MSGBOX_SPK_DEV=plughw:CARD=Device,DEV=0

# GPIO pins. Button and LED values use BCM numbering; NFC values use Blinka
# board pin names.
MSGBOX_BUTTON_PIN=17
MSGBOX_LED_PIN=26
MSGBOX_NFC_RESET_PIN=D20
MSGBOX_NFC_REQUEST_PIN=D16

# ALSA mixer card/control names and startup levels
MSGBOX_MIC_CARD=mic
MSGBOX_MIC_CONTROL=Mic
MSGBOX_MIC_GAIN=100%
MSGBOX_SPEAKER_CARD=Device
MSGBOX_SPEAKER_CONTROL=PCM
MSGBOX_SPEAKER_VOLUME=50%

# Canonical household dashboard. The interface name is resolved to its current
# IPv4 address so the no-login dashboard is not exposed on other interfaces.
MSGBOX_DASH_BIND=wlan0
MSGBOX_DASH_PORT=80

# Optional, device-local Tailscale Serve hostname. Leave blank in repository
# configuration; scripts/provision-tailscale.sh discovers and manages it.
MSGBOX_TAILSCALE_HOST=

# A fresh settings document uses Hold and release and play only. Existing saved
# choices are retained. Change behavior in the Button Box dashboard. Supported
# initial caregiver values below are migrated once into the settings document.
MSGBOX_NFC_DETECTION_BEEP=1

# GPIO, device paths, microphone gain, and runtime timing remain operator-only.
# Runtime sends use an immediate lock attempt to delegate through continuous
# sync; MSGBOX_LOCK_WAIT does not override voice/reaction/presence commands.

# Incoming ordinary videos are accepted only when the downloaded file and its
# audio track stay within these bounds. Voice-note behavior is unchanged.
MSGBOX_VIDEO_MAX_BYTES=104857600
MSGBOX_VIDEO_MAX_DURATION_S=600

# Connection mode: wacli (default) or cloud.
# Existing installations stay on wacli unless deliberately reconfigured.
MSGBOX_TRANSPORT=wacli
# Cloud setup uses a persistent random device identity and credential under
# /var/lib/messagebox-cloud. No provider credentials belong on the device.
# The HTTPS URL must end in /cloud-api/v1. See docs/cloud-runtime.md.
# MSGBOX_CLOUD_API_URL=https://button.box/cloud-api/v1
# Work notification socket is enabled by default; set 0 for polling only.
MSGBOX_CLOUD_EVENTS=1
