# Message Box configuration - installed as /etc/messagebox/env by onboarding.
# Contact identity and chat access are stored privately in contacts.json. Use
# messagebox-contact to add, remove, and enroll contacts and NFC cards.

# ALSA devices by card NAME (numbers shuffle between boots). Fresh setup
# replaces the microphone and speaker values with detected ALSA devices.
MSGBOX_MIC_DEV=plughw:CARD=mic,DEV=0
MSGBOX_SPK_DEV=plughw:CARD=Device,DEV=0

# GPIO pins. Button and LED values use BCM numbering; NFC values use Blinka
# board pin names.
MSGBOX_BUTTON_PIN=17
MSGBOX_LED_PIN=26
MSGBOX_NFC_RESET_PIN=D20
MSGBOX_NFC_REQUEST_PIN=D16

# Recipient-selector transport for messagebox-nfc.service: "i2c" (default, a
# PN532 reader) or "switch" (a single-pole, 5-position rotary/toggle switch
# used as a card substitute -- no PN532 hardware required). MSGBOX_SWITCH_PINS
# is only read in "switch" mode: BCM pins in position order, common wired to
# GND, one contact per pin (avoid pins already claimed above and I2C's 2/3).
MSGBOX_NFC_TRANSPORT=i2c
MSGBOX_SWITCH_PINS=5,6,12,13,19

# ALSA mixer card/control names and startup levels
MSGBOX_MIC_CARD=mic
MSGBOX_MIC_CONTROL=Mic
MSGBOX_MIC_GAIN=100%
MSGBOX_SPEAKER_CARD=Device
MSGBOX_SPEAKER_CONTROL=PCM
MSGBOX_SPEAKER_VOLUME=50%

# Dashboard bind address. Use the Pi's Tailscale address for private access.
MSGBOX_DASH_BIND=

# Play confirmation beeps for detected and enrolled NFC cards.
MSGBOX_NFC_DETECTION_BEEP=1

# Signal channel (signal-cli-rest-api container). Only needed if a contact
# uses --channel signal. The number is the linked Signal account, matching
# what was used during Signal pairing/linking.
MSGBOX_SIGNAL_REST_URL=http://127.0.0.1:8080
MSGBOX_SIGNAL_NUMBER=
MSGBOX_SIGNAL_REST_PORT=8080

# Optional features and timing values use safe built-in defaults. They are not
# part of the supported public configuration surface until their onboarding and
# documentation are complete.
