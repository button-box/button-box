# Button Box configuration - installed as /etc/messagebox/env by setup.
# Contact identity and chat access are stored privately in contacts.json. Use
# messagebox-contact to add, remove, and enroll contacts and NFC cards.

# ALSA devices by card NAME (numbers shuffle between boots). Fresh setup
# replaces the microphone and speaker values with detected ALSA devices.
MSGBOX_MIC_DEV=plughw:CARD=mic,DEV=0
MSGBOX_SPK_DEV=plughw:CARD=Device,DEV=0

# GPIO pins. Button and LED values use BCM numbering; NFC values use Blinka
# board pin names.
MSGBOX_BUTTON_PIN=17
MSGBOX_LED_PIN=26
MSGBOX_NFC_RESET_PIN=D20
MSGBOX_NFC_REQUEST_PIN=D16

# ALSA mixer card/control names and startup levels
MSGBOX_MIC_CARD=mic
MSGBOX_MIC_CONTROL=Mic
MSGBOX_MIC_GAIN=100%
MSGBOX_SPEAKER_CARD=Device
MSGBOX_SPEAKER_CONTROL=PCM
MSGBOX_SPEAKER_VOLUME=50%

# Canonical household dashboard. The interface name is resolved to its current
# IPv4 address so the no-login dashboard is not exposed on other interfaces.
MSGBOX_DASH_BIND=wlan0
MSGBOX_DASH_PORT=80

# Optional, device-local Tailscale Serve hostname. Leave blank in repository
# configuration; scripts/provision-tailscale.sh discovers and manages it.
MSGBOX_TAILSCALE_HOST=

# Initial caregiver values are migrated once into the settings document. After
# first launch, change them in the Button Box dashboard.
MSGBOX_NFC_DETECTION_BEEP=1

# GPIO, device paths, microphone gain, and runtime timing remain operator-only.
