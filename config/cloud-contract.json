{
  "schema": 1,
  "description": "Every Cloud request the box client makes. Generated by scripts/dev/cloud_contract.py.",
  "api_base": "/cloud-api/v1",
  "common": {
    "auth": "Authorization: Bearer <device credential> unless an entry says otherwise",
    "json_success_status": 200,
    "error_body": {
      "error": {
        "code": "string"
      }
    },
    "rate_limited": {
      "status": 429,
      "header": "Retry-After"
    },
    "unknown_response_fields": "ignored"
  },
  "registration_texts": [
    "claim {claim_token}",
    "Hi! I'd like to register my Button Box. Its code is {claim_token}"
  ],
  "entries": [
    {
      "id": "ack",
      "method": "POST",
      "path": "/device/ack",
      "device_state": "claimed",
      "request": {
        "content_type": "application/json",
        "body": {
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:._-]{1,240}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "applied",
              "expired",
              "failed",
              "played",
              "received",
              "rejected"
            ]
          },
          "error_code": {
            "type": "string",
            "optional": true
          }
        }
      },
      "response": {
        "content": "json",
        "status": [
          200
        ],
        "variants": [
          {
            "fields": {
              "operation_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9:._-]{1,240}$",
                "equals_request": "operation_id"
              },
              "accepted": {
                "type": "boolean",
                "const": true
              }
            }
          }
        ]
      },
      "errors": [
        {
          "status": 404,
          "code": "operation_not_found",
          "box_reads": "The box files the ACK as gone and stops retrying it."
        }
      ],
      "box_reads": "Software-update ACK states are covered by the Cloud e2e update simulator.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.ack"
    },
    {
      "id": "claim_status",
      "method": "GET",
      "path": "/device/claim",
      "device_state": "unclaimed",
      "response": {
        "content": "json",
        "status": [
          200
        ],
        "variants": [
          {
            "fields": {
              "claimed": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "box_reads": "claimed=true removes the local claim and shows the box as connected.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.claim"
    },
    {
      "id": "claim_cancel",
      "method": "POST",
      "path": "/device/claim/cancel",
      "device_state": "unclaimed",
      "request": {
        "content_type": "application/json",
        "body": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          }
        }
      },
      "response": {
        "content": "json",
        "status": [
          200
        ],
        "variants": [
          {
            "fields": {
              "claim_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{16,128}$",
                "equals_request": "claim_id"
              },
              "claimed": {
                "type": "boolean",
                "const": false
              },
              "cancelled": {
                "type": "boolean",
                "const": true
              }
            }
          },
          {
            "fields": {
              "claim_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{16,128}$",
                "equals_request": "claim_id"
              },
              "claimed": {
                "type": "boolean",
                "const": true
              },
              "cancelled": {
                "type": "boolean",
                "const": false
              }
            }
          }
        ]
      },
      "box_reads": "The setup page shows status cancelled or claimed. Exactly one of the two flags is true.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.cancel_claim"
    },
    {
      "id": "claim_confirm",
      "method": "POST",
      "path": "/device/claim/confirm",
      "device_state": "unclaimed",
      "request": {
        "content_type": "application/json",
        "body": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          }
        }
      },
      "response": {
        "content": "json",
        "status": [
          200
        ],
        "variants": [
          {
            "fields": {
              "claimed": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "box_reads": "claimed=true finishes setup; claimed=false records the button press.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.confirm_claim"
    },
    {
      "id": "events",
      "method": "GET",
      "path": "/device/events",
      "device_state": "claimed",
      "optional": true,
      "request": {
        "headers": {
          "Upgrade": {
            "type": "string",
            "const": "websocket"
          }
        }
      },
      "response": {
        "content": "websocket",
        "status": [
          101
        ]
      },
      "box_reads": "Work hints only. Without them the box keeps polling the inbox.",
      "source": "messagebox/cloud_events.py::connect_events"
    },
    {
      "id": "heartbeat",
      "method": "POST",
      "path": "/device/heartbeat",
      "device_state": "claimed",
      "request": {
        "content_type": "application/json",
        "body": {
          "version": {
            "type": "string"
          },
          "capabilities": {
            "type": "object"
          },
          "settings": {
            "type": "object"
          },
          "applied_revision": {
            "type": "integer"
          },
          "quiet_state": {
            "type": "object"
          },
          "queue": {
            "type": "object"
          },
          "last_error": {
            "type": "string",
            "nullable": true
          },
          "software_version": {
            "type": "string",
            "optional": true
          },
          "software_commit": {
            "type": "string",
            "optional": true
          },
          "software_update": {
            "type": "object",
            "optional": true
          },
          "remote_access": {
            "type": "object",
            "optional": true
          },
          "nfc_inventory": {
            "type": "object",
            "optional": true
          }
        }
      },
      "response": {
        "content": "json",
        "status": [
          200
        ],
        "variants": [
          {
            "fields": {
              "box_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9:._-]{1,240}$"
              },
              "server_time": {
                "type": "number",
                "min": 1700000000,
                "max": 4102444799
              },
              "account_scope": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "people": {
                "type": "array",
                "max_items": 100,
                "items": {
                  "type": "object",
                  "fields": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9:._-]{1,240}$"
                    },
                    "wa_id": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{6,14}$"
                    },
                    "display_name": {
                      "type": "string",
                      "max_length": 100
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "coadmin",
                        "family",
                        "owner"
                      ]
                    }
                  }
                }
              },
              "entitlement": {
                "type": "object",
                "fields": {
                  "ingest": {
                    "type": "boolean"
                  },
                  "deliver": {
                    "type": "boolean"
                  },
                  "send": {
                    "type": "boolean"
                  },
                  "until": {
                    "type": "number",
                    "min": 1700000000,
                    "max": 4102444799,
                    "nullable": true,
                    "optional": true
                  }
                }
              },
              "queue_hold": {
                "type": "boolean"
              },
              "retention_days": {
                "type": "integer",
                "enum": [
                  7,
                  30,
                  90
                ]
              },
              "desired_revision": {
                "type": "integer",
                "min": 0
              },
              "default_recipient_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9:._-]{1,240}$",
                "nullable": true,
                "optional": true
              },
              "connected_boxes": {
                "type": "array",
                "optional": true
              },
              "reaction_cards": {
                "type": "array",
                "max_items": 6,
                "optional": true
              },
              "kit_cards": {
                "type": "array",
                "optional": true
              },
              "voice_features": {
                "type": "object",
                "optional": true
              }
            }
          }
        ]
      },
      "box_reads": "Any invalid required field makes the box drop the heartbeat and keep its old snapshot.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.heartbeat"
    },
    {
      "id": "inbox",
      "method": "GET",
      "path": "/device/inbox",
      "query": {
        "cursor": {
          "type": "integer",
          "min": 0
        }
      },
      "device_state": "claimed",
      "response": {
        "content": "json",
        "status": [
          200
        ],
        "variants": [
          {
            "fields": {
              "box_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9:._-]{1,240}$"
              },
              "server_time": {
                "type": "number",
                "min": 1700000000,
                "max": 4102444799
              },
              "deleted": {
                "type": "boolean",
                "optional": true
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "fields": {
                    "operation_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9:._-]{1,240}$"
                    },
                    "sequence": {
                      "type": "integer",
                      "min": 0
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "audio",
                        "card_prompt",
                        "delete_message",
                        "install_update",
                        "listened",
                        "mute",
                        "nfc_cancel",
                        "nfc_enroll",
                        "nfc_unpair",
                        "preview_ringtone",
                        "queue_hold",
                        "quiet_now",
                        "reaction",
                        "set_update_mode",
                        "settings",
                        "voice_preview"
                      ]
                    },
                    "created_at": {
                      "type": "number",
                      "min": 1700000000,
                      "max": 4102444799
                    },
                    "expires_at": {
                      "type": "number",
                      "min": 1700000000,
                      "max": 4102444799
                    },
                    "payload": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "box_reads": "One item with an unknown kind makes the box reject the whole inbox.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.inbox"
    },
    {
      "id": "media_listened",
      "method": "GET",
      "path": "/device/listened-media/{clip}",
      "params": {
        "clip": "^[0-9a-f]{64}$"
      },
      "device_state": "claimed",
      "response": {
        "content": "bytes",
        "status": [
          200
        ]
      },
      "box_reads": "The box takes this URL from an inbox listened item.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.media"
    },
    {
      "id": "media_message",
      "method": "GET",
      "path": "/device/media/{message_id}",
      "params": {
        "message_id": "^[A-Za-z0-9_-]{1,128}$"
      },
      "device_state": "claimed",
      "response": {
        "content": "bytes",
        "status": [
          200
        ]
      },
      "box_reads": "The box takes this URL from an inbox audio item.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.media"
    },
    {
      "id": "reaction",
      "method": "POST",
      "path": "/device/reactions",
      "device_state": "claimed",
      "capabilities": {
        "reactions": 1
      },
      "request": {
        "content_type": "application/json",
        "body": {
          "message_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:._-]{1,240}$"
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          },
          "card_id": {
            "type": "string",
            "optional": true
          }
        }
      },
      "response": {
        "content": "json",
        "status": [
          200
        ],
        "variants": [
          {
            "fields": {
              "state": {
                "type": "string",
                "enum": [
                  "nothing_to_react_to",
                  "sent",
                  "uncertain"
                ]
              }
            }
          }
        ]
      },
      "source": "messagebox/cloud_device.py::CloudDeviceClient.send_reaction"
    },
    {
      "id": "register",
      "method": "POST",
      "path": "/device/register",
      "device_state": "new",
      "auth": "body_credential",
      "request": {
        "content_type": "application/json",
        "body": {
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          },
          "credential": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43,128}$"
          },
          "capabilities": {
            "type": "object"
          },
          "software_version": {
            "type": "string",
            "optional": true
          },
          "software_commit": {
            "type": "string",
            "optional": true
          }
        }
      },
      "response": {
        "content": "json",
        "status": [
          200
        ],
        "variants": [
          {
            "fields": {
              "claimed": {
                "type": "boolean",
                "const": true
              }
            }
          },
          {
            "fields": {
              "claim_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{16,128}$"
              },
              "claim_token": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{16,128}$"
              },
              "expires_at": {
                "type": "integer",
                "min": 1700000000,
                "max": 4102444799
              },
              "whatsapp_url": {
                "type": "string",
                "pattern": "^https://wa\\.me/[1-9][0-9]{6,14}\\?text=",
                "prefill_text_one_of": "registration_texts"
              }
            }
          }
        ]
      },
      "box_reads": "claimed=true ends setup; otherwise the claim link and expiry start the setup page. The link text must be one of registration_texts with the claim_token filled in.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.register"
    },
    {
      "id": "setup_checkin",
      "method": "POST",
      "path": "/device/setup-checkin",
      "device_state": "unclaimed",
      "request": {
        "content_type": "application/json",
        "body": {
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          }
        }
      },
      "response": {
        "content": "json",
        "status": [
          200
        ],
        "variants": [
          {
            "fields": {
              "claimed": {
                "type": "boolean",
                "const": true
              }
            }
          },
          {
            "fields": {
              "claimed": {
                "type": "boolean",
                "const": false
              },
              "pending_claim": {
                "type": "object",
                "nullable": true,
                "exact": true,
                "fields": {
                  "claim_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{16,128}$"
                  },
                  "expires_at": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        ]
      },
      "box_reads": "pending_claim must have exactly claim_id and expires_at, or be null.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.setup_checkin"
    },
    {
      "id": "voice_upload",
      "method": "POST",
      "path": "/device/voice",
      "device_state": "claimed",
      "request": {
        "content_type": "multipart/form-data",
        "headers": {
          "Idempotency-Key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          }
        },
        "body": {
          "recipient_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "account_scope": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          },
          "duration_seconds": {
            "type": "string"
          },
          "reply_to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:._-]{1,240}$",
            "optional": true
          },
          "audio": {
            "type": "file",
            "content_type": "audio/ogg"
          }
        }
      },
      "response": {
        "content": "json",
        "status": [
          200,
          202
        ],
        "variants": [
          {
            "fields": {
              "message_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9:._-]{1,240}$"
              },
              "state": {
                "type": "string",
                "enum": [
                  "accepted",
                  "canceled",
                  "deleted",
                  "delivered",
                  "expired",
                  "failed",
                  "held_for_review",
                  "queued",
                  "read",
                  "uncertain",
                  "waiting_for_reply"
                ]
              },
              "expires_at": {
                "type": "integer",
                "min": 1700000000,
                "max": 4102444799
              },
              "server_time": {
                "type": "integer",
                "min": 1700000000,
                "max": 4102444799
              }
            }
          }
        ]
      },
      "box_reads": "400, 401, 403, 404, 409, 413 and 422 are final rejections; other failures are retried.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.send_voice"
    },
    {
      "id": "voice_line",
      "method": "POST",
      "path": "/device/voice-lines",
      "device_state": "claimed",
      "capabilities": {
        "voice_lines": 1
      },
      "request": {
        "content_type": "application/json",
        "body": {
          "template": {
            "type": "string"
          },
          "identity_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:._-]{1,240}$",
            "optional": true
          },
          "link_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:._-]{1,240}$",
            "optional": true
          }
        }
      },
      "response": {
        "content": "json",
        "status": [
          200
        ],
        "variants": [
          {
            "fields": {
              "use_fallback": {
                "type": "boolean",
                "const": true
              }
            }
          },
          {
            "fields": {
              "clip_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "content_type": {
                "type": "string",
                "const": "audio/wav"
              },
              "media_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "voice_pack": {
                "type": "string",
                "nullable": true,
                "optional": true
              }
            }
          }
        ]
      },
      "box_reads": "Any other answer makes the box play its built-in fallback sound.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.voice_line"
    },
    {
      "id": "media_voice_line",
      "method": "GET",
      "path": "/device/voice-lines/{clip_id}",
      "params": {
        "clip_id": "^[0-9a-f]{64}$"
      },
      "device_state": "claimed",
      "capabilities": {
        "voice_lines": 1
      },
      "response": {
        "content": "bytes",
        "status": [
          200
        ]
      },
      "box_reads": "The box takes this URL from a voice line or reaction payload.",
      "source": "messagebox/cloud_device.py::CloudDeviceClient.media"
    },
    {
      "id": "voice_status",
      "method": "GET",
      "path": "/device/voice/status",
      "query": {
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        }
      },
      "device_state": "claimed",
      "response": {
        "content": "json",
        "status": [
          200
        ],
        "variants": [
          {
            "fields": {
              "message_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9:._-]{1,240}$"
              },
              "state": {
                "type": "string",
                "enum": [
                  "accepted",
                  "canceled",
                  "deleted",
                  "delivered",
                  "expired",
                  "failed",
                  "held_for_review",
                  "queued",
                  "read",
                  "uncertain",
                  "waiting_for_reply"
                ]
              },
              "expires_at": {
                "type": "integer",
                "min": 1700000000,
                "max": 4102444799
              },
              "server_time": {
                "type": "integer",
                "min": 1700000000,
                "max": 4102444799
              },
              "deleted": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "errors": [
        {
          "status": 404,
          "code": "voice_upload_not_found",
          "box_reads": "The upload never arrived; the box may upload it again."
        }
      ],
      "source": "messagebox/cloud_device.py::CloudDeviceClient.voice_status"
    }
  ]
}
