[Unit]
# Cloud bootstrap gates this activator on recovery, a normal service.
# Its default Before=paths.target would cycle through basic.target.
DefaultDependencies=no
Requires=sysinit.target
After=basic.target
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathExists=!/var/lib/button-box-update/install-inhibit
Description=Watch for Button Box Wi-Fi change requests

[Path]
PathExists=/var/lib/messagebox-settings/wifi-change.json
Unit=messagebox-wifi-change.service

[Install]
WantedBy=multi-user.target
