[Unit]
Description=Button Box PN532 recipient-card reader
After=local-fs.target
Before=messagebox-button.service
PartOf=messagebox.target

[Service]
Type=simple
User=messagebox
Group=messagebox
WorkingDirectory=/opt/messagebox
EnvironmentFile=/etc/messagebox/env
Environment=HOME=/var/lib/messagebox
SupplementaryGroups=i2c gpio
UMask=0077
ExecStart=/opt/messagebox/venv-nfc/bin/python -u -m messagebox.nfc daemon
Restart=always
RestartSec=3

[Install]
WantedBy=messagebox.target
