[Unit]
Description=Message Box PN532 recipient-card reader
After=local-fs.target
Before=messagebox-button.service
PartOf=messagebox.target

[Service]
Type=simple
User=messagebox
Group=messagebox
WorkingDirectory=/run/messagebox
EnvironmentFile=/etc/messagebox/env
Environment=HOME=/var/lib/messagebox
SupplementaryGroups=i2c gpio
UMask=0077
ExecStart=/opt/messagebox/venv-nfc/bin/python -u /opt/messagebox/nfc.py daemon
Restart=always
RestartSec=3

[Install]
WantedBy=messagebox.target
