[Unit]
Description=Button Box household dashboard
After=network-online.target
Wants=network-online.target
PartOf=messagebox.target

[Service]
User=messagebox
Group=messagebox
SupplementaryGroups=messagebox-settings
WorkingDirectory=/opt/messagebox
EnvironmentFile=/etc/messagebox/env
Environment=HOME=/var/lib/messagebox
Environment=WACLI_STORE_DIR=/var/lib/messagebox/wacli
UMask=0077
ExecStart=/usr/bin/python3 -m messagebox.dashboard.app
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=messagebox.target
