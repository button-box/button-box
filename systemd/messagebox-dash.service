[Unit]
Description=Message Box dashboard (stats + queue manager, Tailscale-only)
After=network-online.target tailscaled.service
Wants=network-online.target
PartOf=messagebox.target

[Service]
User=messagebox
Group=messagebox
WorkingDirectory=/run/messagebox
EnvironmentFile=/etc/messagebox/env
Environment=HOME=/var/lib/messagebox
Environment=WACLI_STORE_DIR=/var/lib/messagebox/wacli
UMask=0077
ExecStart=/usr/bin/python3 /opt/messagebox/dashboard.py
Restart=always
RestartSec=5

[Install]
WantedBy=messagebox.target
