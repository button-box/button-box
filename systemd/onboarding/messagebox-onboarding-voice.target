[Unit]
Description=Button Box setup two-way voice proof
ConditionPathExists=/etc/messagebox-onboarding/enabled
ConditionPathExists=/var/lib/messagebox/state/onboarding-voice-request.json
Wants=messagebox-sync.service messagebox-poller.service messagebox-onboarding-button.service
After=messagebox-sync.service messagebox-poller.service messagebox-onboarding-button.service

[Install]
WantedBy=multi-user.target
