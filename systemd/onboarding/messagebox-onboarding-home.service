[Unit]
Description=Message Box onboarding portal on the home network
ConditionPathExists=/etc/messagebox-onboarding/enabled
BindsTo=comitup.service
PartOf=comitup.service
Requires=messagebox-whatsapp-pairing.service messagebox-onboarding-nfc.service
Conflicts=comitup-web.service
After=comitup.service network-online.target messagebox-whatsapp-pairing.service messagebox-onboarding-nfc.service comitup-web.service

[Service]
Type=simple
User=messagebox-onboarding
Group=messagebox-onboarding
WorkingDirectory=/opt/messagebox
Environment=HOME=/var/lib/messagebox-onboarding
Environment=MSGBOX_ONBOARDING_MODE=HOME
UMask=0077
ExecStart=/usr/bin/gunicorn --workers 1 --worker-class sync --bind 0.0.0.0:80 --error-logfile - messagebox.onboarding.app:app
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/messagebox-onboarding
ReadWritePaths=/var/lib/messagebox-onboarding
LimitCORE=0
