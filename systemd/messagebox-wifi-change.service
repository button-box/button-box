[Unit]
Description=Apply one transactional Button Box Wi-Fi change
After=NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/messagebox
Environment=PYTHONPATH=/opt/messagebox
ExecStart=/usr/bin/python3 -m messagebox.wifi_change
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/messagebox-settings /var/lib/NetworkManager /var/lib/comitup /etc/NetworkManager /etc/messagebox-onboarding /var/lib/messagebox-onboarding /run
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LimitCORE=0
