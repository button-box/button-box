[Unit]
# Cloud bootstrap gates this activator on recovery, a normal service.
# Its default Before=paths.target would cycle through basic.target.
DefaultDependencies=no
Requires=sysinit.target
After=basic.target
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathExists=!/var/lib/button-box-update/install-inhibit
Description=Watch Button Box boot-mode authority

[Path]
PathChanged=/etc/messagebox-onboarding/enabled
PathExists=/run/messagebox-mode-reconcile.pending
Unit=messagebox-mode-reconcile.service

[Install]
WantedBy=multi-user.target
