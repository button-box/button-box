[Unit]
# Cloud bootstrap gates this activator on recovery, a normal service.
# Its default Before=timers.target would cycle through basic.target.
DefaultDependencies=no
Requires=sysinit.target
After=basic.target
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathExists=!/var/lib/button-box-update/install-inhibit
Description=Check Button Box runtime Wi-Fi every 30 seconds
ConditionPathExists=!/etc/messagebox-onboarding/enabled
PartOf=messagebox.target

[Timer]
OnActiveSec=30s
OnUnitInactiveSec=30s
AccuracySec=5s

[Install]
WantedBy=messagebox.target
